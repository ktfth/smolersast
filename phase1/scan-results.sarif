              "id": "SMOL0009",
              "name": "SMOL0009",
              "shortDescription": {
                "text": "BinaryFormatter usage detected. BinaryFormatter is inherently insecure and cannot be made safe. Any deserialized data can execute arbitrary code regardless of applied validations."
              },
              "fullDescription": {
                "text": "Uso de BinaryFormatter detectado. BinaryFormatter \u00E9 inerentemente inseguro e n\u00E3o pode ser tornado seguro. Qualquer dado deserializado pode executar c\u00F3digo arbitr\u00E1rio, independente de valida\u00E7\u00F5es aplicadas."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "High",
                "tags": [
                  "deserialization",
                  "binary-formatter"
                ],
                "cwe": [
                  "CWE-502"
                ],
                "owasp": "A08:2021"
              }
            }
          ]
        }
      },

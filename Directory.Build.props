<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <Version>0.3.0</Version>
    <Authors>SmolerSAST</Authors>
    <Company>SmolerSAST</Company>
    <Copyright>Copyright (c) 2026 SmolerSAST</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/smolersast/smolersast</PackageProjectUrl>
    <RepositoryUrl>https://github.com/smolersast/smolersast</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sast;security;dotnet;roslyn;static-analysis;cwe;owasp;lgpd;bacen</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>
